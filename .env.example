# ========== ENVIRONMENT ==========
ENVIRONMENT=development
DEBUG=false

# ========== DATABASE ==========
POSTGRES_DB=lumiar
POSTGRES_USER=lumiar
POSTGRES_PASSWORD=lumiar_dev_password
DATABASE_URL=postgresql+psycopg2://lumiar:lumiar_dev_password@postgres:5432/lumiar

# ========== REDIS ==========
REDIS_URL=redis://redis:6379/0
REDIS_ENABLED=true

# ========== SECURITY ==========
SECRET_KEY=change-this-secret-in-production-MIN-32-CHARS-HERE
ADMIN_INITIAL_PASSWORD=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ========== RATE LIMITING ==========
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# ========== CORS & URLs ==========
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
PUBLIC_URL=http://localhost:8001
# Para testar com a câmera de um celular na mesma rede Wi-Fi, troque localhost
# pelo IPv4 da máquina que executa o Docker (por exemplo, 192.168.1.50).
MOBILE_APP_URL=http://localhost:8001/api/v1/public/scan

# ========== STORAGE ==========
STORAGE_PATH=uploads
MAX_UPLOAD_SIZE_MB=100

# ========== LOGGING ==========
LOG_LEVEL=INFO

# ========== EXTERNAL APIs ==========
AI_PROVIDER=auto
GOOGLE_API_KEY=
AI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_AI_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=25
AI_CHAT_MAX_OUTPUT_TOKENS=400
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ========== STRIPE BILLING ==========
# Use chaves de teste (sk_test_ / whsec_) no desenvolvimento.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=brl
STRIPE_SUCCESS_URL=http://localhost:5173/?checkout=success
STRIPE_CANCEL_URL=http://localhost:5173/?checkout=cancelled
